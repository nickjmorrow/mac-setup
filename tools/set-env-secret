#!/bin/bash
# Set or rotate a shared env secret (an API key any project or agent reads from the environment) from the clipboard.
# It goes to Bitwarden as env:NAME (so `secrets.py pull` keeps it on every Mac), to this Mac's ~/.zshrc.local, and to
# ~/.zshrc.local on each SSH host named. The value never appears on screen or in shell history.
# Usage: copy the value, then  tools/set-env-secret NAME [ssh-host ...]
set -euo pipefail

name=${1:?usage: set-env-secret NAME [ssh-host ...]}
shift
[[ $name =~ ^[A-Z_][A-Z0-9_]*$ ]] || { echo "NAME must match ^[A-Z_][A-Z0-9_]*\$" >&2; exit 1; }
value=$(pbpaste | tr -d '\r\n')
[[ -n $value ]] || { echo "The clipboard is empty: copy the value first." >&2; exit 1; }
[[ $value != *"'"* ]] || { echo "The value contains a single quote; set it with secrets.py push-env instead." >&2; exit 1; }
line="export $name='$value'"

repo=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
chmod 600 "$tmp"
printf '%s\n' "$line" >"$tmp"
"$repo/secrets.py" push-env "$tmp"

# Replace the NAME line in ~/.zshrc.local (the new line arrives on stdin), keeping every other line.
replace='f=~/.zshrc.local; touch "$f"; chmod 600 "$f"; { grep -v "^export '"$name"'=" "$f" || true; cat; } >"$f.new" && mv "$f.new" "$f"'
printf '%s\n' "$line" | bash -c "$replace"
echo "set on this Mac"
for host in "$@"; do
  printf '%s\n' "$line" | ssh "$host" "$replace"
  echo "set on $host"
done
echo "New shells see $name; restart services that read it."
